# ------------------------------------------------------------------ core
APP_NAME="MEIKO AGENT"
ENVIRONMENT=development            # development | testing | production
DEBUG=false
SECRET_KEY=                        # REQUIRED in production; generated per-process when empty (sessions die on restart)
API_PREFIX=/api/v1
AUTO_CREATE_SCHEMA=true            # false in containers: Alembic owns the schema

# -------------------------------------------------------------- database
# PostgreSQL is the primary target; SQLite is the zero-config fallback.
DATABASE_URL=postgresql+asyncpg://meiko:meiko@postgres:5432/meiko
# DATABASE_URL=sqlite+aiosqlite:///./data/meiko.db
REDIS_URL=redis://redis:6379/0
# Direct (non-pooled) URL for Alembic. Required when DATABASE_URL points at a
# transaction-mode pooler (Supabase pgbouncer, port 6543): DDL needs a real
# connection. Empty = reuse DATABASE_URL.
# MIGRATION_URL=postgresql+asyncpg://meiko:meiko@db:5432/meiko

# ------------------------------------------------------------ encryption
# Fernet key protecting bot tokens at rest. Generated into data/.encryption_key
# on first boot when empty – change only with a re-encryption migration.
ENCRYPTION_KEY=

# --------------------------------------------------------------- telegram
BOT_TOKEN=
OWNER_TELEGRAM_IDS=                # comma separated telegram ids with owner role
WEBHOOK_URL=
WEBHOOK_SECRET=
POLLING_ENABLED=true

# ------------------------------------------------------------ module data
# Where module documents (music queues, links, shops, jobs) are persisted.
# Empty = <DATA_DIR>/modules on a filesystem that must outlive the process.
# A serverless host (Vercel) has no such filesystem: point this at a Storage
# bucket instead and nothing is written to local disk.
# MODULE_STORE_URL=supabase://<project-ref>/meiko-modules
# MODULE_STORE_TOKEN=                 # service-role key; server-to-server only
# MODULE_STORE_BASE_URL=              # self-hosted Storage override

# ---------------------------------------------------------------- runtime
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json
RUN_MAIN_BOT=true
MAX_CLONE_WORKERS=25
CLONE_HEARTBEAT_SECONDS=20
CLONE_CRASH_LOOP_THRESHOLD=5
CLONE_CRASH_LOOP_WINDOW_SECONDS=300
SCHEDULER_ENABLED=true
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=30

# -------------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_DEV_MODE=false                # never enabled with ENVIRONMENT=production
SESSION_TTL_SECONDS=604800
RATE_LIMIT_PER_MINUTE=240

# ----------------------------------------------------------------- plugins
# Global-scope plugin installations are a platform-owner capability. Never
# grant this to ordinary users; set to false to disable the capability itself.
PLUGIN_GLOBAL_SCOPE_ENABLED=true

# ----------------------------------------------------------------- webapp
# Consumed by the Next.js server (route handler proxy).
MEIKO_API_URL=http://api:8000
